# Environment Variables for 4am-Student Backend

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/4am_student

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_SECRET=your-super-secret-jwt-key-change-this-to-a-random-32-char-string
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-to-a-random-32-char-string

# Google Gemini AI (for mock interview AI responses)
GEMINI_API_KEY=your-gemini-api-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Server
PORT=3001
NODE_ENV=development
